# Copy to .env and fill in what you have. trackside reads .env from the
# directory it is started in, and real environment variables win over it.
#
# One .env per running instance: two copies with the same Rail Data
# Marketplace credentials share a Kafka consumer group, and each then misses
# part of every feed. Don't start a local `trackside serve` in a folder that
# holds your server's .env.

# Postgres connection string. docker compose sets this for you.
DATABASE_URL=postgres://trackside:trackside@localhost:5432/trackside?sslmode=disable

LISTEN_ADDR=:8080
LOG_LEVEL=info

# Require this key on every request except /healthz, as
# "Authorization: Bearer <key>" or as a Basic auth password (any user name).
# Browsers ask for it once. Comma-separate several keys to rotate them.
# Leave empty for an open server. Generate one with: openssl rand -hex 24
API_KEY=

# --- Network Rail open data (publicdatafeeds.networkrail.co.uk) -------------
# Register, wait for the activation email, then subscribe under My Feeds
# (see docs/data-feeds.md). Needed for downloads and STOMP feeds unless you
# use the Rail Data Marketplace instead.
NR_USERNAME=
NR_PASSWORD=
# Must be unique per running instance; names the durable STOMP subscriptions.
NR_CLIENT_ID=

# --- Rail Data Marketplace (raildata.org.uk) Kafka feeds ---------------------
# One subscription per product, each with its own key, secret and group:
# copy them from the product's Pub/Sub tab. A Network Rail feed set here is
# read from Kafka instead of STOMP.
RDM_DARWIN_USERNAME=
RDM_DARWIN_PASSWORD=
RDM_DARWIN_GROUP=
# RDM_TRUST_USERNAME=
# RDM_TRUST_PASSWORD=
# RDM_TRUST_GROUP=
# RDM_VSTP_USERNAME=
# RDM_VSTP_PASSWORD=
# RDM_VSTP_GROUP=
# RDM_TD_USERNAME=
# RDM_TD_PASSWORD=
# RDM_TD_GROUP=

# --- Darwin Lite (National Rail OpenLDBWS) ----------------------------------
# The developer token from the registration email. Gives Darwin forecasts on
# demand, one station at a time, if you don't have the Darwin stream above.
# Ignored when RDM_DARWIN_* is set.
NRE_LDBWS_TOKEN=

# --- Inbox: files the Rail Data Marketplace delivers (docs/data-feeds.md) ----
# INBOX_DIR=/path/to/folder
# INBOX_BUCKET=gs://your-bucket
# INBOX_ACCESS_KEY=
# INBOX_SECRET_KEY=
# INBOX_SFTP=sftp://user@host:22/upload
# INBOX_SFTP_PASSWORD=
# INBOX_SFTP_HOST_KEY="ssh-ed25519 AAAA..."

# --- iOS Live Activity pushes (docs/ios-live-activities.md) -----------------
# The .p8 key on one line, with \n for each line break, or APNS_KEY_FILE=path.
# APNS_KEY=-----BEGIN PRIVATE KEY-----\nMIGT...\n-----END PRIVATE KEY-----
# APNS_KEY_ID=ABCDE12345
# APNS_TEAM_ID=FGHIJ67890
# APNS_BUNDLE_IDS=com.example.TrackSide
# APNS_ENV=production

# --- Other -------------------------------------------------------------------
# HISTORY_DAYS=400
# MAP_TILE_URL=https://tile.example.com/{z}/{x}/{y}.png
# MAP_TILE_ATTRIBUTION=© OpenStreetMap contributors
