# Postgres connection string (docker-compose sets this for you).
DATABASE_URL=postgres://trackside:trackside@localhost:5432/trackside?sslmode=disable

# Network Rail open data account: register at https://publicdatafeeds.networkrail.co.uk,
# wait for the activation email, then subscribe to the feeds under My Feeds (see README).
# Without these, trackside serves whatever timetable you import by hand, with no live data.
NR_USERNAME=
NR_PASSWORD=

# Must be unique per running instance; names the durable STOMP subscriptions.
NR_CLIENT_ID=

LISTEN_ADDR=:8080
LOG_LEVEL=info

# Rail Data Marketplace (raildata.org.uk) Kafka subscriptions, one per product.
# Copy the consumer key, secret and group from each product's Pub/Sub page.
# A Network Rail feed set here is read from Kafka instead of STOMP.
RDM_DARWIN_USERNAME=
RDM_DARWIN_PASSWORD=
RDM_DARWIN_GROUP=
# RDM_TRUST_USERNAME= / RDM_TRUST_PASSWORD= / RDM_TRUST_GROUP=
# RDM_VSTP_USERNAME=  / RDM_VSTP_PASSWORD=  / RDM_VSTP_GROUP=
# RDM_TD_USERNAME=    / RDM_TD_PASSWORD=    / RDM_TD_GROUP=

# Darwin Lite (National Rail OpenLDBWS) developer token. Gives Darwin
# forecasts on demand, one station at a time, if you don't have the Darwin
# stream above. Ignored when RDM_DARWIN_* is set.
NRE_LDBWS_TOKEN=

# Inbox: import files the Rail Data Marketplace delivers (see README).
# INBOX_DIR=/path/to/folder
# INBOX_BUCKET=gs://your-bucket
# INBOX_ACCESS_KEY=
# INBOX_SECRET_KEY=
